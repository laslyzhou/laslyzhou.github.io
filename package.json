{
  "name": "build-your-own-radar",
  "version": "0.3.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:dev": "webpack --mode development --config webpack.dev.js",
    "build:prod": "webpack --mode production --config webpack.prod.js",
    "dev": "webpack-dev-server --mode development --config webpack.dev.js",
    "test": "jasmine",
    "test:e2e": "cypress run --env host=$TEST_URL",
    "lint-prettier:check": "eslint . && prettier --check .",
    "lint-prettier:fix": "eslint . --fix && prettier --write .",
    "start": "cypress open --env host=$TEST_URL,TEST_ENV=$TEST_ENV",
    "coverage": "nyc npm run test",
    "quality": "npm run lint-prettier:check && npm run coverage"
  },
  "author": "Thoughtworks",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoughtworks/build-your-own-radar"
  },
  "keywords": [
    "tech-radar"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.7",
    "cypress": "^14.5.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-cypress": "^5.1.0",
    "eslint-plugin-jasmine": "^4.2.2",
    "expose-loader": "^5.0.1",
    "html-webpack-plugin": "^5.6.3",
    "jasmine": "^5.8.0",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "mochawesome": "^7.1.3",
    "nyc": "^17.1.0",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.2.4",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.100.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "chance": "^1.1.13",
    "d3": "^7.9.0",
    "d3-tip": "^0.9.1",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.1",
    "lodash": "^4.17.21",
    "sanitize-html": "^2.17.0"
  },
  "standard": {
